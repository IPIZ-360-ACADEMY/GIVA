VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Backward compatibility only (deprecated in Supabase):
# VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_AUTH_EMAIL_DOMAIN=giva.ao
# URL pública da aplicação — usado como redirectTo no OAuth (Google/LinkedIn)
# Definir no Vercel: Settings > Environment Variables
VITE_APP_URL=https://www.ipiz-giva.com
VITE_EMAIL_PROVIDER=edge-first
VITE_SUPABASE_EMAIL_EDGE_FUNCTION=send-account-email

# Optional (Node scripts only)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Backward compatibility only (deprecated in Supabase):
# SUPABASE_SERVICE_ROLE_KEY=sb_service_role_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional (email branding for edge function)
EMAIL_FROM=no-reply@ipiz-giva.com
EMAIL_FROM_NAME=IPIZ GIVA
EMAIL_LOGO_PNG_URL=https://www.ipiz-giva.com/images/logo-email.png
EMAIL_LOGO_URL=https://www.ipiz-giva.com/images/logo.png
